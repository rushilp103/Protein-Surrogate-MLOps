data/docking/*
!data/docking/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models and generated outputs
models/*
!models/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

